# Шаблон переменных окружения для развёртывания на сервере КБТУ.
# Скопировать в .env рядом с docker-compose.prod.yml и заполнить значения.
# Файл .env в репозиторий не попадает — он исключён в .gitignore.
#
# Секреты сгенерировать, а не придумывать:
#   openssl rand -hex 32

# ---------- Путь проекта на сервере ----------
# Проект отдаётся по адресу esg.kbtu.kz<PROJECT_BASE_PATH>.
# Слеши с обеих сторон обязательны — этого требует Vite.
PROJECT_BASE_PATH=/air-quality/

# ---------- База данных ----------
POSTGRES_USER=aqi
POSTGRES_PASSWORD=ЗАМЕНИТЬ_НА_СГЕНЕРИРОВАННЫЙ_ПАРОЛЬ
POSTGRES_DB=aqi
POSTGRES_HOST=aqi-db
POSTGRES_PORT=5432

# Хост совпадает с именем сервиса в docker-compose.prod.yml.
DATABASE_URL=postgresql+psycopg://aqi:ЗАМЕНИТЬ_НА_СГЕНЕРИРОВАННЫЙ_ПАРОЛЬ@aqi-db:5432/aqi

# ---------- Кэш ----------
REDIS_URL=redis://aqi-redis:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

# ---------- Приложение ----------
APP_ENV=production
LOG_LEVEL=INFO
TZ=Asia/Almaty

# Защита служебных маршрутов /api/admin/* и списка подписчиков.
# Обязательно сгенерировать: наружу смотрит выгрузка наблюдений.
ADMIN_TOKEN=ЗАМЕНИТЬ_НА_СГЕНЕРИРОВАННЫЙ_ТОКЕН

# Фронтенд и API отдаются с одного адреса через публичный nginx, поэтому
# кросс-доменных запросов нет и CORS фактически не задействован. Значение
# оставлено на случай обращения к API со стороннего адреса.
CORS_ORIGINS=https://esg.kbtu.kz

# Префикс пути для Swagger: без него страница /docs не подтянет схему,
# так как запрашивает /openapi.json от корня домена. Без завершающего слеша.
ROOT_PATH=/air-quality

# ---------- Источники данных ----------
OPEN_METEO_AQ_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_WEATHER_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
AIRKAZ_URL=https://airkaz.org/map_data.php
AIRKAZ_ENABLED=false
HTTP_TIMEOUT_SECONDS=30

# ---------- Планировщик ----------
INGEST_CRON_MINUTE=5
FORECAST_CRON_MINUTE=15
RETRAIN_CRON_HOUR=3

# ---------- ML ----------
MODEL_DIR=/app/models
FORECAST_HORIZON_HOURS=48
TRAIN_HISTORY_DAYS=730
AQI_BREAKPOINTS=epa_2024

# ---------- Telegram-бот ----------
# Пустой токен — бот не запускается. Профиль bot всё равно не поднимается
# без явного --profile bot.
BOT_TOKEN=
API_BASE_URL=http://aqi-api:8000
DIGEST_HOUR=7
DIGEST_MINUTE=30
ALERT_CHECK_MINUTE=20

# ---------- Frontend ----------
# Пусто: запросы уходят относительно PROJECT_BASE_PATH, внутренний nginx
# проксирует их в aqi-api. Задавать значение нужно только если фронтенд
# должен обращаться к API напрямую, минуя прокси.
VITE_API_BASE_URL=
