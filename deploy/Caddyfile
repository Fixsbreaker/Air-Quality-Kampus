# Публичный вход на собственном сервере.
#
# Caddy сам получает сертификат Let's Encrypt при первом запуске и сам его
# продлевает — отдельный certbot и задания в cron не нужны. Условие одно:
# домен из DOMAIN должен указывать A-записью на этот сервер, а порты 80 и 443
# должны быть открыты и в облачном фаерволе, и на самой машине.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# Внутренний nginx проекта сам решает, что отдать статикой, а что
	# проксировать в API. Здесь проект живёт в корне домена, поэтому
	# никаких префиксов снимать не нужно.
	reverse_proxy aqi-web:80

	log {
		output stdout
		format console
	}
}
