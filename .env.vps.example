# Шаблон переменных окружения для развёртывания на собственном сервере.
# Скопировать в .env рядом с docker-compose.vps.yml и заполнить.
# Инструкция — docs/DEPLOY_VPS.md.
#
# Секреты сгенерировать, а не придумывать:
#   openssl rand -hex 32

# ---------- Домен и сертификат ----------
# Домен должен указывать A-записью на IP этого сервера ДО первого запуска,
# иначе Caddy не сможет выпустить сертификат. Без http:// и без слеша.
DOMAIN=air.example.com

# Почта для Let's Encrypt: туда придёт предупреждение, если продление сломается.
ACME_EMAIL=you@example.com

# ---------- База данных ----------
POSTGRES_USER=aqi
POSTGRES_PASSWORD=ЗАМЕНИТЬ_НА_СГЕНЕРИРОВАННЫЙ_ПАРОЛЬ
POSTGRES_DB=aqi
POSTGRES_HOST=aqi-db
POSTGRES_PORT=5432

# Пароль должен совпадать с POSTGRES_PASSWORD выше.
DATABASE_URL=postgresql+psycopg://aqi:ЗАМЕНИТЬ_НА_СГЕНЕРИРОВАННЫЙ_ПАРОЛЬ@aqi-db:5432/aqi

# ---------- Кэш ----------
REDIS_URL=redis://aqi-redis:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

# ---------- Приложение ----------
APP_ENV=production
LOG_LEVEL=INFO
TZ=Asia/Almaty

# Защищает выгрузку наблюдений и список подписчиков. Обязательно сгенерировать.
ADMIN_TOKEN=ЗАМЕНИТЬ_НА_СГЕНЕРИРОВАННЫЙ_ТОКЕН

# Фронтенд и API на одном домене, кросс-доменных запросов нет.
# Указать тот же домен, что и в DOMAIN, со схемой https.
CORS_ORIGINS=https://air.example.com

# Проект отдаётся из корня домена, префикса пути нет — оставить пустым.
ROOT_PATH=

# ---------- Источники данных ----------
OPEN_METEO_AQ_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_WEATHER_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
AIRKAZ_URL=https://airkaz.org/map_data.php
AIRKAZ_ENABLED=false
HTTP_TIMEOUT_SECONDS=30

# ---------- Планировщик ----------
INGEST_CRON_MINUTE=5
FORECAST_CRON_MINUTE=15
RETRAIN_CRON_HOUR=3

# ---------- ML ----------
MODEL_DIR=/app/models
FORECAST_HORIZON_HOURS=48
TRAIN_HISTORY_DAYS=730
AQI_BREAKPOINTS=epa_2024

# ---------- Telegram-бот ----------
# Пустой токен — бот не запускается.
BOT_TOKEN=
API_BASE_URL=http://aqi-api:8000
DIGEST_HOUR=7
DIGEST_MINUTE=30
ALERT_CHECK_MINUTE=20

# ---------- Frontend ----------
# Пусто: запросы идут относительно корня, внутренний nginx проксирует /api/.
VITE_API_BASE_URL=
