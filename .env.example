# ---------- База данных ----------
POSTGRES_USER=aqi
POSTGRES_PASSWORD=aqi_password
POSTGRES_DB=aqi
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Полный DSN. Локально (без Docker) заменить db -> localhost
DATABASE_URL=postgresql+psycopg://aqi:aqi_password@aqi-db:5432/aqi

# ---------- Кэш (нереляционное хранилище) ----------
REDIS_URL=redis://aqi-redis:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

# ---------- Приложение ----------
APP_ENV=development
LOG_LEVEL=INFO
TZ=Asia/Almaty

# Токен для защищённых админских эндпоинтов (/api/admin/*)
ADMIN_TOKEN=change-me-in-production

# CORS: адреса фронтенда через запятую
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Префикс пути, если приложение отдаётся не с корня домена (см. docs/DEPLOY.md).
# Локально пусто.
ROOT_PATH=

# ---------- Источники данных ----------
OPEN_METEO_AQ_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_WEATHER_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
AIRKAZ_URL=https://airkaz.org/map_data.php
AIRKAZ_ENABLED=false
HTTP_TIMEOUT_SECONDS=30

# ---------- Планировщик ----------
INGEST_CRON_MINUTE=5          # каждый час на 5-й минуте
FORECAST_CRON_MINUTE=15       # каждый час на 15-й минуте
RETRAIN_CRON_HOUR=3           # переобучение модели в 03:00

# ---------- ML ----------
MODEL_DIR=/app/models
FORECAST_HORIZON_HOURS=48
TRAIN_HISTORY_DAYS=730
AQI_BREAKPOINTS=epa_2024      # epa_2024 | epa_2012

# ---------- Telegram-бот ----------
BOT_TOKEN=
API_BASE_URL=http://aqi-api:8000
DIGEST_HOUR=7
DIGEST_MINUTE=30
ALERT_CHECK_MINUTE=20

# ---------- Frontend ----------
# Пусто = запросы идут относительно базового пути через nginx.
VITE_API_BASE_URL=
